{% if showWidget %}
    {# indexer::stop #}
    <div id="weather-widget" class="mod_weather-widget">
        <div class="temp">{{ temperature }} °C</div>
        <div class="icon">
            <img src="/bundles/plentacontaoweather/{{ icon }}.png"
                 alt="openweathermap.org"
                 title="openweathermap.org">
        </div>
    </div>
    {# indexer::continue #}
{% endif %}